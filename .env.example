# Copy to .env then edit
ADMIN_TOKEN=change-me-to-something-strong
SITES=gpx,kahoot,brm,meteo,ravito,strava,countdown,plik,trace,cyclo,roulette,homepage,dotwatcher,mayojaune
TALLY_PORT=3000
RUST_LOG=info,tally=info

# Container user must match host owner of bind-mounted data (if used).
# Run: echo "UID=$(id -u)" >> .env && echo "GID=$(id -g)" >> .env
UID=1000
GID=1000

# Geo resolution.
# Primary: country header set by reverse proxy (Cloudflare: CF-IPCountry,
# Caddy with geoip module, or your own). Case-insensitive, 2-char ISO-3166-1.
GEO_HEADER=cf-ipcountry
# Fallback: MaxMind GeoLite2 Country .mmdb file (optional). Mount the file
# into the container and set this to its absolute path.
# GEOIP_DB=/data/GeoLite2-Country.mmdb

# Cargo features baked at build time. Keep `geoip` to enable mmdb fallback.
CARGO_FEATURES=geoip
